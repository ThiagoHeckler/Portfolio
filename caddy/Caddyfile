{
	email thiag0224@hotmail.com   # avisos de renovação de certificado
}

# ---------- Snippet de log de acesso ----------
# Importar com "import log_acesso" em cada site que deve registrar acessos.
(log_acesso) {
	log {
		output file /var/log/caddy/access.log {
			roll_size     10MiB   # gira o arquivo ao atingir esse tamanho
			roll_keep     10      # mantém no máximo 10 arquivos girados
			roll_keep_for 2160h   # ~90 dias
		}
		format console
	}
}

# ---------- Site principal (estático, sem JVM) ----------
thiagoheckler.com.br {
	import log_acesso
	root * /srv/site
	file_server
	encode gzip

	# Cache agressivo p/ assets, nenhum p/ HTML
	@static path *.css *.js *.png *.jpg *.svg *.webp *.woff2
	header @static Cache-Control "public, max-age=31536000, immutable"
}

# Redireciona www -> raiz
www.thiagoheckler.com.br {
	redir https://thiagoheckler.com.br{uri} permanent
}

# ---------- Projetos (subdomínios) ----------
siscontabil.thiagoheckler.com.br {
	import log_acesso
	reverse_proxy siscontabil:8080
}

tasks.thiagoheckler.com.br {
	import log_acesso
	encode gzip
	root * /srv/tasks

	# API: remove o /api; o IP do visitante vem do Caddy, nunca do cliente
	handle_path /api/* {
		reverse_proxy task-api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Prefix /api
			# O Spring lê o Forwarded (RFC 7239) antes do X-Forwarded-For: forjado, burlaria
			# o limite por IP e mudaria o host/porta das URLs do Swagger.
			header_up -Forwarded
			header_up -X-Forwarded-Port
		}
	}

	# Front estático da demo (Next.js export)
	handle {
		try_files {path} {path}.html
		file_server
	}

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

