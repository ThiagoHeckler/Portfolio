# Copiar para .env na VPS e preencher. O .env nunca vai para o git.

# PostgreSQL 17 compartilhado (um database por projeto)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=

# MongoDB 8
MONGO_USER=portfolio
MONGO_PASSWORD=

# Auth Service
JWT_SECRET=

# Task API (tasks.thiagoheckler.com.br)
# Segredo próprio, mínimo 32 caracteres: openssl rand -base64 48
TASKAPI_JWT_SECRET=
# Cadastros por dia na demo (fuso de São Paulo) e requisições por minuto por IP
TASKAPI_SIGNUP_DAILY_LIMIT=100
TASKAPI_RATE_LIMIT_PER_MINUTE=120

# Laboratório (lab-admin em admin.thiagoheckler.com.br)
# Hashes bcrypt, sempre entre aspas simples (têm $). Gerar com:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'senha'
# 1) basic_auth do Caddy, primeira barreira (senha diferente da do app):
LAB_BASIC_AUTH_USER=admin
LAB_BASIC_AUTH_HASH=''
# 2) Login do app: o mesmo formato com o prefixo {bcrypt}, ex. '{bcrypt}$2a$14$...'
LAB_ADMIN_USER=admin
LAB_ADMIN_PASSWORD=''
