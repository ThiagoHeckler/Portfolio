# Copiar para .env na VPS e preencher. O .env nunca vai para o git.

# PostgreSQL 17 compartilhado (um database por projeto)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=

# MongoDB 8
MONGO_USER=portfolio
MONGO_PASSWORD=

# Auth Service
JWT_SECRET=

# Task API (tasks.thiagoheckler.com.br)
# Segredo próprio, mínimo 32 caracteres: openssl rand -base64 48
TASKAPI_JWT_SECRET=
# Cadastros por dia na demo (fuso de São Paulo) e requisições por minuto por IP
TASKAPI_SIGNUP_DAILY_LIMIT=100
TASKAPI_RATE_LIMIT_PER_MINUTE=120
